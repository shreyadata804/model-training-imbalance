      "source": [
        "# Step 1: Select only numeric columns (excluding 'Target' if it's present)\n",
        "feature_columns = [col for col in water_quality_df.columns if water_quality_df[col].dtype in ['float64', 'int64'] and col != \"Target\"]\n",
        "\n",
        "# Step 2: Compute Q1, Q3, and IQR\n",
        "Q1 = water_quality_df[feature_columns].quantile(0.25)\n",
        "Q3 = water_quality_df[feature_columns].quantile(0.75)\n",
        "IQR = Q3 - Q1\n",
        "\n",
        "# Step 3: Define lower and upper bounds for outlier detection\n",
        "lower_bound = Q1 - 1.5 * IQR\n",
        "upper_bound = Q3 + 1.5 * IQR\n",
        "\n",
        "# Step 4: Identify and count outliers\n",
        "outliers = ((water_quality_df[feature_columns] < lower_bound) | (water_quality_df[feature_columns] > upper_bound))\n",
        "outliers_count = outliers.sum()\n",
        "print(\"Outliers detected in each column:\\n\", outliers_count)\n",
        "\n",
        "# Step 5: Capping values within the valid range\n",
        "water_quality_df_capped = water_quality_df.copy()\n",
        "\n",
        "# Clip each feature column\n",
        "for col in feature_columns:\n",
        "    water_quality_df_capped[col] = water_quality_df_capped[col].clip(lower=lower_bound[col], upper=upper_bound[col])\n",
        "\n",
        "# Step 6: Display results\n",
        "print(\"\\nOutlier capping applied successfully.\")\n",
        "print(\"Dataset preview after capping:\")\n",
        "print(water_quality_df_capped.head())\n",
        "\n",
        "# Check dataset size before and after capping\n",
        "print(f\"Dataset size before outlier handling: {water_quality_df.shape[0]:,} rows\")\n",
        "print(f\"Dataset size after outlier handling: {water_quality_df_capped.shape[0]:,} rows\")\n",
        "print(f\"Rows removed: {water_quality_df.shape[0] - water_quality_df_capped.shape[0]:,} ({((water_quality_df.shape[0] - water_quality_df_capped.shape[0]) / water_quality_df.shape[0]) * 100:.2f}%)\")"
      ]
    },
