    {
      "cell_type": "markdown",
      "metadata": {
        "id": "-60Ol9gljlMM"
      },
      "source": [
        "### Label Encode Categorical Variables"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "kTXqB-mhjgZ8"
      },
      "outputs": [],
      "source": [
        "# Step 1: Identify categorical columns\n",
        "categorical_columns = X_train.select_dtypes(include=['object', 'category']).columns.tolist()\n",
        "\n",
        "# Step 2: Create a dictionary to store LabelEncoders\n",
        "label_encoders = {}\n",
        "\n",
        "# Step 3: Fit LabelEncoders on training data and transform both train and test\n",
        "for col in categorical_columns:\n",
        "    le = LabelEncoder()\n",
        "\n",
        "    # Fit only on training data\n",
        "    X_train[col] = le.fit_transform(X_train[col].astype(str))\n",
        "\n",
        "    # Store encoder\n",
        "    label_encoders[col] = le\n",
        "\n",
        "    # Apply same encoder to test data\n",
        "    # Handle unknown categories (if any) by mapping to -1\n",
        "    mapping = dict(zip(le.classes_, le.transform(le.classes_)))\n",
        "    X_test[col] = X_test[col].map(mapping).fillna(-1).astype(int)"
      ]
